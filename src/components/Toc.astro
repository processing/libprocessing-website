---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
---

{
  headings.length > 1 && (
    <nav class="toc" aria-label="On this page">
      <p class="title">On this page</p>
      <ul>
        {headings.map(({ depth, slug, text }) => (
          <li data-depth={depth}>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-height) + var(--spacing-l));
    font-size: var(--text-size-body-2xs);
    line-height: var(--leading-loose);
  }

  .title {
    margin-bottom: var(--spacing-s);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-loosest);
    text-transform: uppercase;
  }

  li {
    padding-block: 2px;
  }

  li[data-depth="3"] {
    padding-left: var(--spacing-m);
  }

  a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text-accent);
  }
</style>
