---
import type { NavPage } from '../lib/docs.ts';

interface Props {
  prev?: NavPage;
  next?: NavPage;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Pagination">
      {prev ? (
        <a href={prev.href} rel="prev">
          <span class="direction">← Previous</span>
          <span class="label">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={next.href} rel="next" class="next">
          <span class="direction">Next →</span>
          <span class="label">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-m);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-l);
    background-color: var(--color-bg-field);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  a:hover .label {
    color: var(--color-text-accent);
  }

  .next {
    text-align: right;
  }

  .direction {
    color: var(--color-text-secondary);
    font-size: var(--text-size-body-2xs);
    letter-spacing: var(--letter-spacing-loosest);
    text-transform: uppercase;
  }

  .label {
    font-family: var(--font-family-heading);
    font-size: var(--text-size-heading-2xs);
  }
</style>
