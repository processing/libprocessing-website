---
import type { NavSection } from '../lib/docs.ts';

interface Props {
  sections: NavSection[];
  currentPath: string;
}

const { sections, currentPath } = Astro.props;
---

<details class="sidebar" open data-sidebar>
  <summary>Menu</summary>
  <nav aria-label="Documentation">
    {
      sections.map((section) => (
        <div class="section">
          <a
            class="section-link"
            href={section.href}
            aria-current={section.href === currentPath ? 'page' : undefined}
          >
            {section.label}
          </a>
          {section.pages.length > 0 && (
            <ul>
              {section.pages.map((page) => (
                <li>
                  <a
                    href={page.href}
                    aria-current={page.href === currentPath ? 'page' : undefined}
                    data-status={page.entry.data.status}
                  >
                    {page.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </nav>
</details>

<script>
  const sidebar = document.querySelector<HTMLDetailsElement>('[data-sidebar]');
  const desktop = window.matchMedia('(min-width: 72rem)');
  const sync = () => {
    if (sidebar) sidebar.open = desktop.matches;
  };
  sync();
  desktop.addEventListener('change', sync);
</script>

<style>
  .sidebar {
    font-size: var(--text-size-body-xs);
  }

  summary {
    padding-block: var(--spacing-s);
    border-bottom: 1px solid var(--color-bg-secondary);
    font-size: var(--text-size-body-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-loosest);
    text-transform: uppercase;
    cursor: pointer;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    padding-top: var(--spacing-l);
  }

  .section-link {
    font-family: var(--font-family-heading);
    font-size: var(--text-size-heading-2xs);
  }

  ul {
    margin-top: var(--spacing-xs);
    border-left: 1px solid var(--color-bg-secondary);
  }

  li a {
    display: block;
    margin-left: -1px;
    padding: 3px 0 3px var(--spacing-m);
    border-left: 2px solid transparent;
  }

  a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text-accent);
  }

  a[aria-current="page"] {
    border-color: var(--color-bg-accent);
    color: var(--color-text-accent);
  }

  a[data-status="outline"] {
    color: var(--color-text-secondary);
  }

  @media (--lg) {
    .sidebar {
      position: sticky;
      top: calc(var(--header-height) + var(--spacing-l));
      max-height: calc(100vh - var(--header-height) - var(--spacing-2xl));
      overflow-y: auto;
    }

    summary {
      display: none;
    }

    nav {
      padding-top: 0;
    }
  }
</style>
