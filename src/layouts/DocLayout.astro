---
import type { MarkdownHeading } from 'astro';
import Divider from '../components/Divider.astro';
import LanguageTags from '../components/LanguageTags.astro';
import LinkCards from '../components/LinkCards.astro';
import PrevNext from '../components/PrevNext.astro';
import Sidebar from '../components/Sidebar.astro';
import StatusNotice from '../components/StatusNotice.astro';
import Toc from '../components/Toc.astro';
import {
  editUrlOf,
  flattenNavigation,
  getNavigation,
  hrefOf,
  sectionOf,
  type Doc,
} from '../lib/docs.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: Doc;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, status, languages, links } = entry.data;

const sections = await getNavigation();
const section = sectionOf(sections, entry);
const flat = flattenNavigation(sections);
const index = flat.findIndex((page) => page.entry.id === entry.id);
const editUrl = editUrlOf(entry);
const isSectionIndex = section?.entry.id === entry.id;
---

<BaseLayout title={title} description={description}>
  <div class="row page">
    <aside class="sidebar">
      <Sidebar sections={sections} currentPath={hrefOf(entry)} />
    </aside>

    <article class="article">
      <header class="header">
        {
          section && !isSectionIndex && (
            <p class="eyebrow">
              <a href={section.href}>{section.label}</a>
            </p>
          )
        }
        <h1 class="heading-l">{title}</h1>
        {description && <p class="description">{description}</p>}
        <LanguageTags languages={languages} />
      </header>

      <Divider size="xs" class="divider" />

      <StatusNotice status={status} editUrl={editUrl} />

      {links.length > 0 && <LinkCards links={links} />}

      <div class="prose">
        <slot />
      </div>

      <slot name="after" />

      {
        isSectionIndex && section.pages.length > 0 && (
          <LinkCards
            links={section.pages.map((page) => ({
              label: page.label,
              href: page.href,
              description: page.entry.data.description,
            }))}
          />
        )
      }

      <footer class="article-footer">
        <a class="edit" href={editUrl}>Edit this page on GitHub</a>
        <PrevNext prev={flat[index - 1]} next={flat[index + 1]} />
      </footer>
    </article>

    <aside class="toc">
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .page {
    row-gap: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
    min-width: 0;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--color-text-accent);
  }

  .description {
    color: var(--color-text-secondary);
    font-size: var(--text-size-body-m);
    line-height: var(--leading-loose);
  }

  .divider {
    margin-inline: calc(var(--spacing-column-gap) * -1);
  }

  .article-footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-l);
    margin-top: var(--spacing-3xl);
  }

  .edit {
    color: var(--color-text-secondary);
    font-size: var(--text-size-body-2xs);
  }

  .edit:hover {
    color: var(--color-text-accent);
  }

  .toc {
    display: none;
  }

  @media (--lg) {
    .page {
      padding-top: var(--spacing-3xl);
    }

    .sidebar {
      grid-column: 1 / span 3;
      grid-row: 1;
      align-self: stretch;
    }

    .article {
      grid-column: 4 / span 6;
    }

    .toc {
      display: block;
      grid-column: 10 / span 3;
      align-self: stretch;
    }

    .divider {
      margin-inline: 0;
    }
  }
</style>
